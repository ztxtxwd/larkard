{
  "schema": "2.0",
  "header": {
    "title": { "tag": "plain_text", "content": "Bug 反馈" },
    "template": "red"
  },
  "body": {
    "elements": [
      {
        "tag": "form",
        "name": "bug_form",
        "elements": [
          {
            "tag": "input",
            "name": "title",
            "placeholder": { "tag": "plain_text", "content": "问题标题" },
            "required": true
          },
          {
            "tag": "multi_select_static",
            "name": "severity",
            "behaviors": [{ "type": "callback", "value": { "key": "severity_change" } }],
            "options": [
              { "text": { "tag": "plain_text", "content": "轻微" }, "value": "low" },
              { "text": { "tag": "plain_text", "content": "严重" }, "value": "high" }
            ]
          },
          {
            "tag": "input",
            "name": "repro",
            "placeholder": { "tag": "plain_text", "content": "复现步骤" }
          },
          {
            "tag": "button",
            "text": { "tag": "plain_text", "content": "提交反馈" },
            "type": "primary",
            "name": "submit",
            "form_action_type": "submit",
            "behaviors": [{ "type": "callback", "value": { "action": "submit_bug" } }]
          }
        ]
      }
    ]
  }
}
