{
  "name": "@open-feishu-card/compiler",
  "version": "0.1.3",
  "description": "编译器与净化器：DSL → 标准 RAW JSON，并自动剥离不符合 Schema 2.0 的非标属性",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@open-feishu-card/adapter": "workspace:*",
    "@open-feishu-card/schema": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "@types/node": "^22.20.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztxtxwd/open-feishu-card-monorepo.git",
    "directory": "packages/compiler"
  }
}
