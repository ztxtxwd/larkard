{
  "name": "@open-feishu-card/check",
  "version": "0.1.5",
  "description": "发送前检查：Schema + 字符级诊断 + 最佳实践 + 真机硬约束，可选自动修复（间距值域、面板内边距、媒体字段）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@open-feishu-card/linter": "workspace:*",
    "@open-feishu-card/parser": "workspace:*",
    "@open-feishu-card/schema": "workspace:*",
    "@open-feishu-card/validator": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "@types/node": "^22.20.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztxtxwd/open-feishu-card-monorepo.git",
    "directory": "packages/check"
  }
}
