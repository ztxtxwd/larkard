{
  "name": "@open-feishu-card/adapter",
  "version": "0.3.15",
  "description": "公开 DSL 与飞书内部 RAW JSON 的双向适配器；raw→DSL 对齐 feishu-raw-card-to-dsl",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/adapter.test.ts && vitest run"
  },
  "devDependencies": {
    "@open-feishu-card/schema": "workspace:*",
    "@types/node": "^22.20.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztxtxwd/open-feishu-card-monorepo.git",
    "directory": "packages/adapter"
  }
}
