{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@open-feishu-card/components",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@open-feishu-card/components/jsx-runtime": ["../src/jsx-runtime.ts"],
      "@open-feishu-card/components/jsx-dev-runtime": ["../src/jsx-dev-runtime.ts"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../src/**/*.ts"]
}
