{
  "name": "@open-feishu-card/language-server",
  "version": "0.1.9",
  "description": "飞书卡片 LSP 语言服务器：诊断、智能补全、Hover、Code Action 快速修复",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "open-feishu-card-language-server": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly && chmod +x dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@open-feishu-card/compiler": "workspace:*",
    "@open-feishu-card/linter": "workspace:*",
    "@open-feishu-card/parser": "workspace:*",
    "@open-feishu-card/schema": "workspace:*",
    "@open-feishu-card/validator": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "@types/node": "^22.20.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztxtxwd/open-feishu-card-monorepo.git",
    "directory": "packages/language-server"
  }
}
